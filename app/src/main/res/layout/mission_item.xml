<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    app:cardCornerRadius="4dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="?attr/colorPrimary">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- 16:9 thumbnail area -->
        <FrameLayout
            android:id="@+id/item_bkg"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="#1a1a2e"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintDimensionRatio="16:9">

            <!-- Thumbnail image -->
            <ImageView
                android:id="@+id/item_thumbnail"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="@null" />

            <!-- Fallback icon shown when no thumbnail -->
            <ImageView
                android:id="@+id/item_icon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:scaleType="fitCenter"
                android:contentDescription="@null"
                app:tint="?attr/actionColor"
                android:visibility="gone" />

            <!-- Download progress fill (ProgressDrawable background on this overlay) -->
            <View
                android:id="@+id/item_progress_overlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0.0" />

            <!-- Watch progress bar at bottom of thumbnail (scaleX + pivotX=0 used for progress) -->
            <View
                android:id="@+id/item_watch_progress"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_gravity="bottom|start"
                android:background="?attr/colorAccent"
                android:visibility="gone" />

        </FrameLayout>

        <!-- Filename + overflow button -->
        <org.schabi.newpipe.views.NewPipeTextView
            android:id="@+id/item_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="XXX.xx"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="13sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/item_bkg"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/item_more" />

        <ImageView
            android:id="@+id/item_more"
            style="?attr/buttonBarButtonStyle"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="4dp"
            android:contentDescription="@null"
            android:scaleType="center"
            android:src="@drawable/ic_more_vert"
            app:tint="?attr/actionColor"
            app:layout_constraintTop_toBottomOf="@id/item_bkg"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Size -->
        <org.schabi.newpipe.views.NewPipeTextView
            android:id="@+id/item_size"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="8dp"
            android:text="100.00MB"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="11sp"
            app:layout_constraintTop_toBottomOf="@id/item_name"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/item_status"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- Status (percentage) -->
        <org.schabi.newpipe.views.NewPipeTextView
            android:id="@+id/item_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="8dp"
            android:text="0%"
            android:textColor="?attr/colorAccent"
            android:textSize="11sp"
            app:layout_constraintTop_toBottomOf="@id/item_name"
            app:layout_constraintEnd_toStartOf="@+id/item_date"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- Date -->
        <org.schabi.newpipe.views.NewPipeTextView
            android:id="@+id/item_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="8dp"
            android:text=""
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="11sp"
            app:layout_constraintTop_toBottomOf="@id/item_name"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>
